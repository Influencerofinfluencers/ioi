# Kopieer naar .env (lokaal) of zet elke regel als GitHub Secret (Settings > Secrets and variables > Actions)

# Database: Supabase > Project Settings > Database > Connection string (URI, "Session pooler")
DATABASE_URL=postgresql://postgres.xxxx:WACHTWOORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

SITE_URL=https://JOUWNAAM.github.io/ioi
BRAND=IOI - Influencer of Influencers

# X: developer.x.com > je app > Keys and tokens > Bearer Token. Zet ook een bestedingslimiet in de console!
X_BEARER_TOKEN=
X_MAX_RESULTS=20

# YouTube: console.cloud.google.com > YouTube Data API v3 > API key (alleen nodig voor 'verify')
YOUTUBE_API_KEY=

# Telegram-lezen (my.telegram.org > API development tools) + sessie via: python -m ioi.cli telegram-login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Instagram Business Discovery (eigen zakelijk IG-account gekoppeld aan een Facebook-pagina)
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_VERSION=v25.0

# AI: "anthropic" (Claude) of "openai" (OpenRouter/Groq/Together/... met open-source modellen)
LLM_PROVIDER=anthropic
# Per stap (optioneel): open-source voor labelen, Claude voor schrijven
LABEL_PROVIDER=anthropic
WRITE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LABEL_MODEL=claude-haiku-5-5
WRITE_MODEL=claude-sonnet-5-5
# Alleen bij LLM_PROVIDER=openai, bv. OpenRouter met een Qwen- of Llama-model als LABEL_MODEL
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
DIGEST_LANGUAGE=English

# Telegram-bot (@BotFather) + chat-id's (bot als beheerder toevoegen aan je kanalen)
TELEGRAM_BOT_TOKEN=
TELEGRAM_STATUS_CHAT_ID=
TELEGRAM_PUBLIC_CHAT_ID=@jouw_gratis_kanaal
TELEGRAM_PRO_CHAT_ID=

# Analyse
ALERT_WINDOW_HOURS=6
ALERT_MIN_ACCOUNTS=4
ECHO_WINDOW_HOURS=24
